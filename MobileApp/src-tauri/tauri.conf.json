{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conductor Mobile",
  "version": "0.1.0",
  "identifier": "com.conductor.mobile",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Conductor", "width": 400, "height": 760 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
